# Copier en .env (jamais versionné) puis adapter.
DB_NAME=odc
DB_USER=odc
# Obligatoire. Prod : openssl rand -hex 24
DB_PASSWORD=change-me

# Obligatoire en prod : URL des clés publiques (JWKS) de ton fournisseur OAuth2
# Exemple Keycloak : https://auth.example.com/realms/odc/protocol/openid-connect/certs
JWT_JWK_SET_URI=
